// trace: D116, D127, D155. The sums of `money.normal.wax`, kept exactly in a `HugeDecimal`.
proc run[n: Whole] -> Whole
    mut total: HugeDecimal = 0.00
    mut tax: HugeDecimal = 0.00
    mut i = 0
    while i < n
        price: HugeDecimal = 4.99
        total = total + price * (i rem.floor 7 + 1)
        tax = tax + price * 0.08
        i = i + 1
    end
    share = (total + tax) div.floor 3
    return be.Whole.floor(share) ?? 0
end
