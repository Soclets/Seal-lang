record Body
    x: Float
    y: Float
    z: Float
    vx: Float
    vy: Float
    vz: Float
    mass: Float
end

proc energy[bodies: List<Body>] -> Float
    mut total = 0.0
    for each body at pos i in bodies
        total = total + 0.5 * body.mass * (body.vx * body.vx + body.vy * body.vy + body.vz * body.vz)
        for each other at pos j in bodies
            if j > i
                dx = body.x - other.x
                dy = body.y - other.y
                dz = body.z - other.z
                total = total - body.mass * other.mass / sqrt(dx * dx + dy * dy + dz * dz)
            end
        end
    end
    return total
end

proc advance[bodies: List<Body>, dt: Float] -> List<Body>
    mut moved = bodies
    count = moved.len
    for each i in range[from: 1, to: count]
        for each j in range[from: i + 1, before: count + 1]
            dx = moved[pos: i].x - moved[pos: j].x
            dy = moved[pos: i].y - moved[pos: j].y
            dz = moved[pos: i].z - moved[pos: j].z
            distance_squared = dx * dx + dy * dy + dz * dz
            mag = dt / (distance_squared * sqrt(distance_squared))
            moved[pos: i].vx = moved[pos: i].vx - dx * moved[pos: j].mass * mag
            moved[pos: i].vy = moved[pos: i].vy - dy * moved[pos: j].mass * mag
            moved[pos: i].vz = moved[pos: i].vz - dz * moved[pos: j].mass * mag
            moved[pos: j].vx = moved[pos: j].vx + dx * moved[pos: i].mass * mag
            moved[pos: j].vy = moved[pos: j].vy + dy * moved[pos: i].mass * mag
            moved[pos: j].vz = moved[pos: j].vz + dz * moved[pos: i].mass * mag
        end
        moved[pos: i].x = moved[pos: i].x + dt * moved[pos: i].vx
        moved[pos: i].y = moved[pos: i].y + dt * moved[pos: i].vy
        moved[pos: i].z = moved[pos: i].z + dt * moved[pos: i].vz
    end
    return moved
end

proc run[steps] -> Float
    pi = ~3.141592653589793
    solar_mass = 4.0 * pi * pi
    days = ~365.24
    mut bodies = [
        Body[x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass],
        Body[x: ~4.84143144246472090, y: -~1.16032004402742839, z: -~0.103622044471123109,
             vx: ~0.00166007664274403694 * days, vy: ~0.00769901118419740425 * days,
             vz: -~0.0000690460016972063023 * days, mass: ~0.000954791938424326609 * solar_mass],
        Body[x: ~8.34336671824457987, y: ~4.12479856412430479, z: -~0.403523417114321381,
             vx: -~0.00276742510726862411 * days, vy: ~0.00499852801234917238 * days,
             vz: ~0.0000230417297573763929 * days, mass: ~0.000285885980666130812 * solar_mass],
        Body[x: ~12.8943695621391310, y: -~15.1111514016986312, z: -~0.223307578892655734,
             vx: ~0.00296460137564761618 * days, vy: ~0.00237847173959480950 * days,
             vz: -~0.0000296589568540237556 * days, mass: ~0.0000436624404335156298 * solar_mass],
        Body[x: ~15.3796971148509165, y: -~25.9193146099879641, z: ~0.179258772950371181,
             vx: ~0.00268067772490389322 * days, vy: ~0.00162824170038242295 * days,
             vz: -~0.0000951592254519715870 * days, mass: ~0.0000515138902046611451 * solar_mass]
    ]
    mut px = 0.0
    mut py = 0.0
    mut pz = 0.0
    for each body in bodies
        px = px + body.vx * body.mass
        py = py + body.vy * body.mass
        pz = pz + body.vz * body.mass
    end
    bodies[pos: 1].vx = -px / solar_mass
    bodies[pos: 1].vy = -py / solar_mass
    bodies[pos: 1].vz = -pz / solar_mass
    mut step = 0
    while step < steps
        bodies = advance(bodies, ~0.01)
        step = step + 1
    end
    return energy(bodies)
end
