// Purpose: making and dropping values on the heap. A tree 10 deep is made and dropped `rounds` times, never read.
one_of Tree
    leaf
    node[left: Tree, right: Tree]
end

proc build[depth: Whole] -> Tree
    if depth == 0
        return Tree.leaf
    else
        return Tree.node[left: build(depth - 1), right: build(depth - 1)]
    end
end

proc run[rounds] -> Whole
    mut made = 0
    for each unused round in range[from: 1, to: rounds]
        unused tree = build(10)
        made = made + 1
    end
    return made
end
