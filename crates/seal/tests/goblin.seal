mut hp = 30
show_msg("loaded")

proc on_hit[amount: Whole]
    hp = hp - amount
    show_msg("hit for {amount}, {hp} left")
end

proc hp_left[unit: Text] -> Text
    return "{hp}{unit}"
end

proc heal[amount, times : Whole]
    labels [amount as by, times as times]
    defaults [times: 1]
    hp = hp + amount * times
end

proc handle[event: Event] -> Whole
    match event
        case idle
        case hurt[amount]
            hp = hp - amount
        case healed[amount, by]
            hp = hp + amount
            show_msg("{by} healed {amount}")
    end
    return hp
end

proc patrol[guard: Whole]
    mut passes = 0
    names = ["north", "south"]
    while true
        damage(guard, by: 1)
        wait(seconds: 2)
        passes = passes + 1
        show_msg("pass {passes} of {names.len}")
    end
end

proc spin[start: Whole]
    mut count = start
    while true
        count = count + 1
    end
end

proc hoard[item: Text]
    mut pile = [item]
    while pile.len > 0
        pile.add("{item}{item}")
    end
end

proc overflow[n: Whole] -> Whole
    return n * 9223372036854775807
end

proc strongest[id: Whole] -> Text
    enemy = enemy_info(id)
    return enemy.name
end

proc add_goblin[start_hp: Whole] -> Whole
    return spawn(Enemy[name: "Goblin", hp: start_hp])
end

proc target[fallback: Whole] -> Whole
    return nearest_enemy() ?? fallback
end

proc save_game[slot: Whole] ! [no_slot]
    save(slot) otherwise
        case disk_full
            show_msg("the disk is full")
        case no_slot
            fail no_slot
    end
end

proc on_tick
    hp = hp + 1
end

proc full_hp -> Whole
    return 30
end
