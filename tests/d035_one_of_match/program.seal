one_of Event
    idle
    hurt[amount: Whole]
    healed[amount: Whole, by: Text]
end one_of Event

mut hp = 30

proc handle[event: Event]
    match event
        case idle
            show_msg("nothing happens")
        case hurt[amount]
            hp = hp - amount
            show_msg("hurt for {amount}, {hp} left")
        case healed[amount, by]
            hp = hp + amount
            show_msg("{by} healed {amount}, {hp} left")
    end match
end proc handle

handle(Event.hurt[amount: 5])
handle(Event.idle)
handle(Event.healed[amount: 3, by: "Mia"])
