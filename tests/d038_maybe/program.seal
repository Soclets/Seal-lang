proc first_above[scores: List<Whole>, limit: Whole] -> Maybe<Whole>
    for each score in scores
        if score > limit
            return Maybe.some[value: score]
        end
    end
    return Maybe.none
end

results = [3, 12, 7]
found = first_above(results, 10)
match found
    case some[value]
        show_msg("found {value}")
    case none
        show_msg("none found")
end
high = first_above(results, 20) ?? 0
show_msg("high: {high}")
