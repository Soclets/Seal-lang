proc doubled_level[level: Whole] -> Whole ! [too_high]
    if level > 10
        fail too_high
    else
        ret level * 2
    end
end

a = doubled_level(3) ?? 0
b = doubled_level(12) ?? -1
show_msg("{a} {b}")
c = doubled_level(20) otherwise
    case too_high
        show_msg("too high")
        use 99
end
show_msg("{c}")
