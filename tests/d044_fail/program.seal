proc doubled_level[level: Whole] -> Whole
    if level > 10
        fail too_high
    else
        return level * 2
    end if
end proc doubled_level

a = doubled_level(3) ?? 0
b = doubled_level(12) ?? -1
show_msg("{a} {b}")
c = doubled_level(20) otherwise
    case too_high
        show_msg("too high")
        instead 99
end otherwise
show_msg("{c}")
