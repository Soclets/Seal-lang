proc load_level[name: Text] -> Whole ! [not_found, broken]
    if name == "cave"
        ret 5
    elif name == "ruin"
        fail broken
    else
        fail not_found
    end
end

proc pick[name: Text] -> Whole
    level = load_level(name) otherwise
        case not_found
            ret 1
        case broken
            use 0
    end
    show_msg("loaded {name}")
    ret level + 10
end

a = pick("cave")
b = pick("ruin")
c = pick("swamp")
show_msg("{a} {b} {c}")
