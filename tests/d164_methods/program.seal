record Enemy
    name: Text
    hp: Whole

    proc is_alive[enemy: Enemy] -> Bool
        return enemy.hp > 0
    end

    proc size[enemy: Enemy] -> Whole
        return enemy.hp div.ceil 10
    end
end

one_of Tree
    leaf
    node[left: Tree, right: Tree]

    proc size[tree: Tree] -> Whole
        match tree
            case leaf
                return 1
            case node[left, right]
                return 1 + left.size() + right.size()
        end
    end
end

goblin = Enemy[name: "Goblin", hp: 30]
ghost = Enemy[name: "Ghost", hp: 0]
tree = Tree.node[left: Tree.leaf, right: Tree.leaf]
a = goblin.is_alive()
b = ghost.is_alive()
c = goblin.size()
d = tree.size()
show_msg("{a} {b} {c} {d}")
