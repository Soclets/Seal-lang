proc load_level[name: Text] -> Whole ! [not_found]
    if name eq "cave"
        return 5
    else
        fail not_found
    end
end

group.handler level_failed
    handles [load_level]
    _::start_over
        case not_found
            instead 1
    end
    _::give_up
        case not_found
            return 0
    end
end

group.unit coins
    _::copper base
    _::silver = 10 copper
end

proc best_level[name: Text] -> Whole
    level = load_level(name) ?? _::*give_up
    return level * 10
end

mut level = 3
level = load_level("swamp") ?? _::start_over
show_msg("{level}")
bonus = load_level("cave") ?? level_failed::start_over
level = _ + bonus
show_msg("{level}")
high = best_level("cave")
low = best_level("swamp")
show_msg("{high} {low}")
purse = 2 silver + 5 copper
show_msg("{purse}")
